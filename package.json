{
  "name": "react-skip-logic",
  "version": "0.1.0",
  "description": "Headless branching / skip-logic engine for multi-step forms, surveys and quizzes in React. Describe your flow as JSON, bring your own UI. Live demo: https://mankarsandesh.github.io/react-skip-logic/",
  "keywords": ["react", "survey", "form", "skip-logic", "branching", "wizard", "multi-step", "quiz", "onboarding", "headless"],
  "license": "MIT",
  "author": "Sandesh Mankar",
  "homepage": "https://mankarsandesh.github.io/react-skip-logic/",
  "repository": { "type": "git", "url": "https://github.com/mankarsandesh/react-skip-logic" },
  "bugs": { "url": "https://github.com/mankarsandesh/react-skip-logic/issues" },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./core": {
      "import": { "types": "./dist/core.d.ts", "default": "./dist/core.js" },
      "require": { "types": "./dist/core.d.cts", "default": "./dist/core.cjs" }
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": { "react": ">=17" },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
